<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}MesAnimaux{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        <header class="site-header">
            <nav class="shell navigation" aria-label="Navigation principale">
                <a class="brand" href="{{ path('app_accueil') }}">MesAnimaux<span>.</span></a>
                <div class="nav-actions">
                    <a href="{{ path('app_catalogue') }}"{% if app.current_route in ['app_accueil', 'app_catalogue'] %} aria-current="page"{% endif %}>Catalogue</a>
                    <a class="button button-outline" href="{{ path('app_panier') }}"{% if app.current_route == 'app_panier' %} aria-current="page"{% endif %}>Panier <span data-cart-count>0</span></a>
                </div>
            </nav>
        </header>
        <main id="contenu" class="shell">
            {% block body %}{% endblock %}
        </main>
        <footer class="shell site-footer">MesAnimaux</footer>
    </body>
</html>
